# Select credentials for the provider used by --llm.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.6-27b-awq2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-flash

# Reference runtime defaults; credentials above remain provider-specific.
MAC_BUILD_MAX_WORKERS=4
MAC_SEMANTIC_MAX_WORKERS=4
MAC_QA_MAX_WORKERS=4
MAC_JUDGE_MAX_WORKERS=12
MAC_LLM_MAX_CONCURRENCY=4
OUR_V1_SESSION_MAX_WORKERS=2
SESSION_FACT_MAX_FACTS_PER_CALL=64
CROSS_ENCODER_MODEL=Qwen/Qwen3-Reranker-0.6B
CROSS_ENCODER_LOCAL_FILES_ONLY=true
CROSS_ENCODER_BATCH_SIZE=8
CROSS_ENCODER_MAX_LENGTH=512
DEEPSEEK_REQUEST_TIMEOUT=900
DEEPSEEK_API_MAX_RETRIES=3
DEEPSEEK_API_RETRY_BACKOFF=2
QWEN_REQUEST_TIMEOUT=900
QWEN_API_MAX_RETRIES=3
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false
# Optional overrides (unset = dataset reference defaults):
# MAC_SEMANTIC_BATCH_SIZE=40          # LoCoMo 40; LongMemEval 80
# SEMANTIC_REQUEST_TIMEOUT=900        # LoCoMo 900; LongMemEval 300
# SEMANTIC_API_MAX_RETRIES=3          # LoCoMo 3; LongMemEval 1
